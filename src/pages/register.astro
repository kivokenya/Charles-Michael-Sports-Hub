---
import BaseLayout from '../layouts/BaseLayout.astro';
import SportIcon from '../components/SportIcon.astro';

const sports = [
  { value: 'Taekwondo', name: 'taekwondo', description: 'Our flagship martial art and tournament sport' },
  { value: 'Athletics', name: 'athletics', description: 'Track, field and general fitness activities' },
  { value: 'Martial arts', name: 'martial-arts', description: 'Explore martial arts opportunities beyond taekwondo' },
  { value: 'Boxing', name: 'boxing', description: 'Fitness, technique and boxing training' },
  { value: 'Football', name: 'football', description: 'Team play and football skills' },
  { value: 'Darts', name: 'darts', description: 'Focus, precision and friendly competition' },
  { value: 'Board games', name: 'board-games', description: 'Strategy, problem-solving and social play' },
];
---

<BaseLayout
  title="Register Your Interest"
  description="Register your interest in joining Charles Michael Sports Hub in Limuru. Choose taekwondo, athletics, martial arts, boxing, football, darts or board games."
>
  <section class="bg-navy text-white py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[1.2fr_.8fr] gap-12 items-center">
      <div>
        <p class="section-subtitle text-red-brand">Find Your Sport</p>
        <h1 class="font-display font-black text-5xl sm:text-6xl md:text-7xl leading-none mb-6">Register Your Interest</h1>
        <p class="font-body text-blue-100 text-lg sm:text-xl leading-relaxed max-w-2xl mb-8">
          Tell us a little about yourself and choose the sports you are interested in. Our team will follow up with information about current programmes and activities in development.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#registration-form" class="btn-primary">Start your registration</a>
          <a href="https://wa.me/254754151315" target="_blank" rel="noopener noreferrer" class="btn-secondary">Message us directly</a>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-3 justify-items-center" aria-label="Sports at Charles Michael Sports Hub">
        {sports.map((sport) => (
          <div class="flex flex-col items-center gap-2 text-center">
            <SportIcon name={sport.name} label={sport.value} size="lg" decorative />
            <span class="font-body text-xs sm:text-sm text-blue-100">{sport.value}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12 bg-bluegrey">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-3 gap-5">
      <article class="card p-6 flex items-start gap-4">
        <SportIcon name="taekwondo" label="Taekwondo flagship" decorative />
        <div>
          <h2 class="font-display font-bold text-xl text-navy mb-1">Taekwondo is our flagship</h2>
          <p class="font-body text-sm text-gray-600">Our established programme and the martial art featured in our international tournament.</p>
        </div>
      </article>
      <article class="card p-6 flex items-start gap-4">
        <SportIcon name="community" label="Inclusive sports" decorative />
        <div>
          <h2 class="font-display font-bold text-xl text-navy mb-1">A growing sports offer</h2>
          <p class="font-body text-sm text-gray-600">Other activities are being developed in stages as coaches, facilities and partnerships become available.</p>
        </div>
      </article>
      <article class="card p-6 flex items-start gap-4">
        <SportIcon name="shield" label="Safe participation" decorative />
        <div>
          <h2 class="font-display font-bold text-xl text-navy mb-1">Young people welcome</h2>
          <p class="font-body text-sm text-gray-600">A parent or guardian should complete the form for anyone under 18.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="py-16 pb-28 md:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="section-subtitle">A Few Details</p>
        <h2 class="section-title">Choose what interests you</h2>
        <p class="font-body text-gray-600 text-lg mt-4">This form prepares a message to the Hub on WhatsApp. Review it there and press Send to complete your enquiry.</p>
      </div>

      <form id="registration-form" class="card p-6 sm:p-9 space-y-7">
        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="full-name" class="form-label">Your full name <span aria-hidden="true">*</span></label>
            <input id="full-name" name="fullName" type="text" autocomplete="name" required maxlength="100" class="form-control" placeholder="Enter your name" />
          </div>
          <div>
            <label for="age-group" class="form-label">Age group <span aria-hidden="true">*</span></label>
            <select id="age-group" name="ageGroup" required class="form-control">
              <option value="">Select an age group</option>
              <option value="Under 8">Under 8</option>
              <option value="8 to 12">8 to 12</option>
              <option value="13 to 17">13 to 17</option>
              <option value="18 to 24">18 to 24</option>
              <option value="25 to 39">25 to 39</option>
              <option value="40 and above">40 and above</option>
            </select>
          </div>
          <div>
            <label for="phone" class="form-label">Your phone or WhatsApp number <span aria-hidden="true">*</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" required minlength="8" maxlength="24" class="form-control" placeholder="+254 7XX XXX XXX" />
          </div>
          <div>
            <label for="email" class="form-label">Email address <span class="font-normal text-gray-500">(optional)</span></label>
            <input id="email" name="email" type="email" autocomplete="email" maxlength="150" class="form-control" placeholder="you@example.com" />
          </div>
        </div>

        <fieldset>
          <legend class="form-label mb-3">Which sports interest you? <span aria-hidden="true">*</span></legend>
          <p class="font-body text-sm text-gray-500 mb-4">Choose one or more. Your choices help us understand what the community wants.</p>
          <div class="grid sm:grid-cols-2 gap-3">
            {sports.map((sport) => (
              <label class="sport-choice">
                <input type="checkbox" name="sports" value={sport.value} class="sport-checkbox" />
                <SportIcon name={sport.name} label={sport.value} decorative />
                <span>
                  <span class="block font-display font-bold text-lg text-navy">{sport.value}</span>
                  <span class="block font-body text-xs text-gray-500">{sport.description}</span>
                </span>
              </label>
            ))}
          </div>
          <p id="sport-error" class="hidden mt-3 text-sm text-red-700" role="alert">Choose at least one sport to continue.</p>
        </fieldset>

        <div id="guardian-fields" class="hidden grid sm:grid-cols-2 gap-5">
          <div>
            <label for="guardian-name" class="form-label">Parent or guardian name <span aria-hidden="true">*</span></label>
            <input id="guardian-name" name="guardianName" type="text" autocomplete="name" maxlength="100" class="form-control" />
          </div>
          <div>
            <label for="guardian-phone" class="form-label">Parent or guardian phone <span aria-hidden="true">*</span></label>
            <input id="guardian-phone" name="guardianPhone" type="tel" autocomplete="tel" minlength="8" maxlength="24" class="form-control" placeholder="+254 7XX XXX XXX" />
          </div>
          <p class="sm:col-span-2 font-body text-sm text-gray-500">A parent or guardian must submit this request and contact us on behalf of anyone under 18.</p>
        </div>

        <div>
          <label for="experience" class="form-label">Previous sports experience <span class="font-normal text-gray-500">(optional)</span></label>
          <select id="experience" name="experience" class="form-control">
            <option value="">Choose an option</option>
            <option value="New to sport">I am new to sport</option>
            <option value="Some experience">I have some experience</option>
            <option value="Regular participant">I already participate regularly</option>
            <option value="Returning after a break">I am returning after a break</option>
          </select>
        </div>

        <div>
          <label for="message" class="form-label">Anything else we should know? <span class="font-normal text-gray-500">(optional)</span></label>
          <textarea id="message" name="message" rows="3" maxlength="500" class="form-control resize-y" placeholder="Tell us what you are looking for. Please do not include medical or other sensitive information."></textarea>
        </div>

        <label class="flex items-start gap-3 font-body text-sm text-gray-600">
          <input id="consent" name="consent" type="checkbox" required class="mt-1 h-4 w-4 accent-red-brand" />
          <span>I agree to share these details with Charles Michael Sports Hub so the team can respond to my enquiry. Read our <a href="/privacy" class="text-navy underline font-semibold">Privacy Notice</a>. <span aria-hidden="true">*</span></span>
        </label>

        <div class="rounded-lg bg-bluegrey p-4 font-body text-sm text-gray-600">
          Your details are not submitted to or stored by this website. The form creates a WhatsApp message for you to review and send. You are not registered for a programme until the Hub contacts you and confirms the next steps.
        </div>

        <button type="submit" class="btn-primary w-full justify-center text-lg py-4">Prepare my message</button>
        <p id="registration-status" class="hidden rounded-lg border border-green-700/20 bg-green-50 p-4 font-body text-sm text-green-900" role="status" aria-live="polite"></p>
        <a id="whatsapp-submit-link" class="hidden btn-navy w-full justify-center" href="#" target="_blank" rel="noopener noreferrer">Open WhatsApp to send your message</a>
      </form>

      <p class="text-center font-body text-sm text-gray-500 mt-6">
        Prefer to speak with us? Call <a href="tel:+254754151315" class="text-navy underline">0754 151 315</a> or message us on <a href="https://wa.me/254754151315" target="_blank" rel="noopener noreferrer" class="text-navy underline">WhatsApp</a>.
      </p>
    </div>
  </section>

  <style>
    .form-label { display: block; margin-bottom: .4rem; color: #1f3a5f; font-family: Inter, sans-serif; font-size: .9rem; font-weight: 700; }
    .form-label [aria-hidden="true"] { color: #b3202a; }
    .form-control { width: 100%; min-height: 3rem; border: 1px solid #cbd5e1; border-radius: .4rem; background: #fff; padding: .75rem .9rem; color: #172b45; font: inherit; }
    .form-control:focus { border-color: #1f3a5f; outline: 3px solid rgba(31,58,95,.18); }
    .sport-choice { display: flex; align-items: center; gap: .85rem; min-height: 5.5rem; border: 1px solid #dbe3ec; border-radius: .7rem; background: #fff; padding: .8rem; cursor: pointer; transition: border-color .2s, box-shadow .2s, transform .2s; }
    .sport-choice:hover { transform: translateY(-2px); border-color: #1f3a5f; box-shadow: 0 8px 18px rgba(21,41,69,.1); }
    .sport-checkbox { width: 1.15rem; height: 1.15rem; flex: none; accent-color: #b3202a; }
    .sport-choice:has(.sport-checkbox:checked) { border-color: #b3202a; background: #fff8f8; box-shadow: 0 0 0 2px rgba(179,32,42,.12); }
    @media (prefers-reduced-motion: reduce) { .sport-choice { transition: none; } }
  </style>

  <script>
    const form = document.getElementById('registration-form') as HTMLFormElement | null;
    const ageGroup = document.getElementById('age-group') as HTMLSelectElement | null;
    const guardianFields = document.getElementById('guardian-fields');
    const guardianName = document.getElementById('guardian-name') as HTMLInputElement | null;
    const guardianPhone = document.getElementById('guardian-phone') as HTMLInputElement | null;
    const sportError = document.getElementById('sport-error');
    const status = document.getElementById('registration-status');
    const whatsappLink = document.getElementById('whatsapp-submit-link') as HTMLAnchorElement | null;

    const updateGuardianFields = () => {
      const needsGuardian = ageGroup?.value === 'Under 8' || ageGroup?.value === '8 to 12' || ageGroup?.value === '13 to 17';
      guardianFields?.classList.toggle('hidden', !needsGuardian);
      if (guardianName) guardianName.required = Boolean(needsGuardian);
      if (guardianPhone) guardianPhone.required = Boolean(needsGuardian);
      if (!needsGuardian) {
        if (guardianName) guardianName.value = '';
        if (guardianPhone) guardianPhone.value = '';
      }
    };

    ageGroup?.addEventListener('change', updateGuardianFields);
    updateGuardianFields();

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const selectedSports = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="sports"]:checked'));
      if (selectedSports.length === 0) {
        sportError?.classList.remove('hidden');
        form.querySelector<HTMLInputElement>('input[name="sports"]')?.focus();
        return;
      }
      sportError?.classList.add('hidden');

      const data = new FormData(form);
      const lines = [
        'Hello Charles Michael Sports Hub, I would like to register my interest.',
        '',
        `Name: ${data.get('fullName')}`,
        `Age group: ${data.get('ageGroup')}`,
        `Phone or WhatsApp: ${data.get('phone')}`,
        `Sports of interest: ${selectedSports.map((input) => input.value).join(', ')}`,
      ];
      if (data.get('email')) lines.push(`Email: ${data.get('email')}`);
      if (data.get('guardianName')) lines.push(`Parent or guardian: ${data.get('guardianName')}`);
      if (data.get('guardianPhone')) lines.push(`Parent or guardian phone: ${data.get('guardianPhone')}`);
      if (data.get('experience')) lines.push(`Experience: ${data.get('experience')}`);
      if (data.get('message')) lines.push(`Additional information: ${data.get('message')}`);

      const url = `https://wa.me/254754151315?text=${encodeURIComponent(lines.join('\n'))}`;
      if (whatsappLink) {
        whatsappLink.href = url;
        whatsappLink.classList.remove('hidden');
      }
      if (status) {
        status.textContent = 'Your message is ready. Open WhatsApp, review your details, and press Send to contact the Hub. Your registration request is not complete until you send the message and receive a reply.';
        status.classList.remove('hidden');
      }
      whatsappLink?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  </script>
</BaseLayout>
