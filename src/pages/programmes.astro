---
import BaseLayout from '../layouts/BaseLayout.astro';
import SportIcon from '../components/SportIcon.astro';

const programmes = [
  {
    id: 'juniors',
    belt: 'bg-yellow-400',
    beltName: 'Yellow Belt',
    title: 'Juniors',
    ages: 'Ages 8–17',
    icon: 'taekwondo',
    who: 'Boys and girls aged 8 to 17, at any level, from complete beginners to those who have trained before.',
    what: [
      'Taekwondo fundamentals: stances, blocks, kicks, punches',
      'Poomsae (patterns) practice and competition',
      'Kyorugi (sparring) introduced progressively and safely',
      'Belt grading examinations',
      'Physical fitness and coordination',
      'Discipline, respect and confidence',
    ],
    schedule: 'Contact us to confirm current class times',
    fee: 'Contact us for current rates',
  },
  {
    id: 'seniors',
    belt: 'bg-red-brand',
    beltName: 'Red Belt',
    title: 'Seniors',
    ages: 'Adults (18+)',
    icon: 'trophy',
    who: 'Adults of any level. Whether you are returning to sport, a complete beginner or training for competition, you are welcome.',
    what: [
      'Advanced kyorugi (sparring) and poomsae',
      'Competition preparation',
      'Strength, agility and endurance training',
      'Belt grading and dan promotion',
      'Fitness and self-discipline',
    ],
    schedule: 'Contact us to confirm current class times',
    fee: 'Contact us for current rates',
  },
  {
    id: 'holiday',
    belt: 'bg-blue-500',
    beltName: 'Blue Belt',
    title: 'Holiday Camps',
    ages: 'School holidays',
    icon: 'community',
    who: 'Junior athletes during school holidays. A great entry point or a fast way to accelerate progress in a short time.',
    what: [
      'Intensive daily training sessions',
      'Physical conditioning',
      'Technique workshops',
      'Fun team activities',
    ],
    schedule: 'Ask us about upcoming camp dates',
    fee: 'Fees shared when dates are confirmed',
  },
  {
    id: 'school',
    belt: 'bg-green-600',
    beltName: 'Green Belt',
    title: 'School Partnerships',
    ages: 'Primary & secondary schools',
    icon: 'certificate',
    who: 'We bring the programme to your school. Ideal for schools looking to add taekwondo to their sports offering.',
    what: [
      'Curriculum-linked sessions during PE or activities time',
      'In-school coaching by CMSH instructors',
      'Grading opportunities for participating pupils',
      'Inter-school tournament pathway',
    ],
    schedule: 'Contact us to discuss a school visit',
    fee: 'Rates depend on partnership requirements',
  },
  {
    id: 'coaching',
    belt: 'bg-purple-700',
    beltName: 'Black Belt Pathway',
    title: 'Coach & Referee Courses',
    ages: 'Adults',
    icon: 'document',
    who: 'Athletes and former athletes looking to give back by coaching or officiating.',
    what: [
      'KTF-accredited coaching certification (coming soon)',
      'KTF-accredited referee certification (coming soon)',
      'Practical training and assessment',
    ],
    schedule: 'Future courses subject to KTF accreditation',
    fee: 'Fees will be shared when courses are confirmed',
  },
];
---

<BaseLayout
  title="Programmes"
  description="Explore taekwondo programmes at Charles Michael Sports Hub in Limuru, Kenya, and register interest in the Hub's developing multi-sport activities."
>

  <!-- Hero -->
  <section class="bg-navy text-white py-24" style="clip-path: polygon(0 0, 100% 0, 100% 88%, 0 100%);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="section-subtitle text-red-brand mb-3">Train With Us</p>
      <h1 class="font-display font-black text-7xl md:text-8xl text-white leading-none mb-6">Programmes</h1>
      <p class="font-body text-blue-100 text-xl max-w-2xl leading-relaxed">
        Taekwondo is our flagship programme. Find current taekwondo opportunities below and tell us which other sports you would like to see at the Hub.
      </p>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-8 items-center">
      <img
        src="/images/dojo-team.webp"
        alt="Coaches and athletes training together on the sports hub mats"
        class="w-full aspect-[4/3] object-cover rounded-lg shadow-lg"
        loading="lazy"
        decoding="async"
      />
      <div>
        <p class="section-subtitle">Train Together</p>
        <h2 class="section-title mb-4">A place to grow through sport</h2>
        <p class="font-body text-gray-600 text-lg leading-relaxed">
          Taekwondo is the Hub's established flagship sport, with opportunities for beginners and experienced athletes. We are also developing a broader sports offer so more young people can find an activity that suits them.
        </p>
      </div>
    </div>
  </section>

  <!-- Belt progress bar -->
  <div class="bg-white border-b border-gray-100 py-5 overflow-x-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-3 min-w-max">
      {['White','Yellow','Green','Blue','Red','Black'].map((belt, i) => (
        <div class="flex items-center gap-3">
          <div class={`w-10 h-4 rounded-sm shadow-sm ${belt === 'White' ? 'bg-gray-200 border border-gray-300' : belt === 'Yellow' ? 'bg-yellow-400' : belt === 'Green' ? 'bg-green-600' : belt === 'Blue' ? 'bg-blue-600' : belt === 'Red' ? 'bg-red-brand' : 'bg-gray-900'}`}></div>
          <span class="font-body text-xs text-gray-500">{belt}</span>
          {i < 5 && <span class="text-gray-300">→</span>}
        </div>
      ))}
    </div>
  </div>

  <!-- Programme cards -->
  <section class="py-20 bg-bluegrey">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      {programmes.map((prog, i) => (
        <div id={prog.id} class="card reveal" style={`transition-delay: ${i * 80}ms`}>
          <div class={`${prog.belt} h-3`}></div>
          <div class="p-8 grid md:grid-cols-3 gap-8 items-start">
            <!-- Left -->
            <div class="md:col-span-1">
              <SportIcon name={prog.icon} label={prog.title} size="lg" decorative />
              <p class="font-body text-xs text-gray-400 uppercase tracking-wider mb-1">{prog.ages}</p>
              <h2 class="font-display font-bold text-5xl text-navy mb-4">{prog.title}</h2>
              <p class="font-body text-gray-600 leading-relaxed mb-6">{prog.who}</p>
              <a href="/register" class="btn-primary text-base px-6 py-3">Register Interest</a>
            </div>
            <!-- Right -->
            <div class="md:col-span-2 grid sm:grid-cols-3 gap-6">
              <div class="sm:col-span-2">
                <h3 class="font-display font-bold text-2xl text-navy mb-4">What to Expect</h3>
                <ul class="space-y-2">
                  {prog.what.map(item => (
                    <li class="flex items-start gap-3 font-body text-gray-600 text-sm">
                      <span class="text-red-brand font-bold mt-0.5 flex-shrink-0">✓</span>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="space-y-4">
                <div class="bg-bluegrey rounded-lg p-5">
                  <p class="font-body text-xs text-gray-400 uppercase tracking-wider mb-1">Schedule</p>
                  <p class="font-display font-bold text-navy text-lg">{prog.schedule}</p>
                </div>
                <div class="bg-bluegrey rounded-lg p-5">
                  <p class="font-body text-xs text-gray-400 uppercase tracking-wider mb-1">Membership Fee</p>
                  <p class="font-display font-bold text-navy text-lg">{prog.fee}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div>
          <p class="section-subtitle">Growing Together</p>
          <h2 class="section-title mb-5">A wider sports community</h2>
          <p class="font-body text-gray-600 text-lg leading-relaxed mb-5">
            Beyond our taekwondo programme, we are working towards opportunities in athletics, martial arts, boxing, football, darts and board games. These activities will be introduced in stages as coaches, facilities and community partnerships become available.
          </p>
          <p class="font-body text-gray-600 leading-relaxed mb-7">
            Tell us which sports interest you. Your response helps us understand local demand, and our team will follow up with information about current or planned opportunities.
          </p>
          <a href="/register" class="btn-primary">Choose your sports</a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
          {[
            { name: 'athletics', label: 'Athletics' },
            { name: 'martial-arts', label: 'Martial arts' },
            { name: 'boxing', label: 'Boxing' },
            { name: 'football', label: 'Football' },
            { name: 'darts', label: 'Darts' },
            { name: 'board-games', label: 'Board games' },
          ].map((sport) => (
            <div class="bg-bluegrey rounded-xl p-5 flex flex-col items-center gap-3 text-center">
              <SportIcon name={sport.name} label={sport.label} decorative />
              <span class="font-display font-bold text-lg text-navy">{sport.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Scholarship note -->
  <section class="py-14 bg-navy text-white text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 reveal">
      <SportIcon name="inclusion" label="Scholarship opportunities" size="lg" decorative />
      <h2 class="font-display font-bold text-5xl mb-4">Scholarship Places</h2>
      <p class="font-body text-blue-100 text-xl leading-relaxed mb-8">
        We hold a number of scholarship places for girls and for families where cost is a barrier. Sport should not be accessible only to those who can easily afford it. Contact us to enquire. All conversations are confidential.
      </p>
      <a href="/contact" class="btn-secondary text-xl px-8 py-4">Enquire in Confidence →</a>
    </div>
  </section>

</BaseLayout>
